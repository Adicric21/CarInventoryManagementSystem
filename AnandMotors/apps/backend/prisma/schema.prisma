generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum InventoryActivityAction {
  VEHICLE_CREATED
  VEHICLE_UPDATED
  VEHICLE_DELETED
  VEHICLE_PURCHASED
  VEHICLE_RESTOCKED
}

model User {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String              @db.VarChar(100)
  email               String              @unique @db.VarChar(320)
  passwordHash        String              @map("password_hash") @db.VarChar(255)
  role                Role                @default(USER)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  inventoryActivities InventoryActivity[]
  purchases           Purchase[]

  @@map("users")
}

model Vehicle {
  id                  String              @id @default(uuid()) @db.Uuid
  make                String              @db.VarChar(100)
  model               String              @db.VarChar(100)
  category            String              @db.VarChar(100)
  price               Decimal             @db.Decimal(14, 2)
  quantity            Int
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  inventoryActivities InventoryActivity[]
  purchases           Purchase[]

  @@map("vehicles")
}

model Purchase {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  vehicleId       String?  @map("vehicle_id") @db.Uuid
  vehicleMake     String   @map("vehicle_make") @db.VarChar(100)
  vehicleModel    String   @map("vehicle_model") @db.VarChar(100)
  vehicleCategory String   @map("vehicle_category") @db.VarChar(100)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(14, 2)
  quantity        Int
  totalAmount     Decimal  @map("total_amount") @db.Decimal(24, 2)
  purchasedAt     DateTime @default(now()) @map("purchased_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([userId, purchasedAt])
  @@index([vehicleId, purchasedAt])
  @@index([purchasedAt])
  @@map("purchases")
}

model InventoryActivity {
  id              String                  @id @default(uuid()) @db.Uuid
  action          InventoryActivityAction
  vehicleId       String?                 @map("vehicle_id") @db.Uuid
  vehicleMake     String                  @map("vehicle_make") @db.VarChar(100)
  vehicleModel    String                  @map("vehicle_model") @db.VarChar(100)
  vehicleCategory String                  @map("vehicle_category") @db.VarChar(100)
  quantityBefore  Int?                    @map("quantity_before")
  quantityChange  Int?                    @map("quantity_change")
  quantityAfter   Int?                    @map("quantity_after")
  performedById   String                  @map("performed_by_id") @db.Uuid
  metadata        Json?
  createdAt       DateTime                @default(now()) @map("created_at")
  vehicle         Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  performedBy     User                    @relation(fields: [performedById], references: [id], onDelete: Restrict)

  @@index([action, createdAt])
  @@index([vehicleId, createdAt])
  @@index([performedById, createdAt])
  @@index([createdAt])
  @@map("inventory_activities")
}
